# ================================================================
# AI for Everyone Course - Environment Variables
# Copy this file to .env.local and fill in values. NEVER commit .env.local.
#
# The site runs fully WITHOUT any of these. They only enable two optional
# features: the feedback form (email + storage) and verifiable certificates
# (Postgres). There is no login - each visitor's lesson progress is stored
# locally in their own browser.
# ================================================================

# ── (Optional) Feedback emails via Resend ────────────────────────
# Get a key at https://resend.com. If unset, feedback simply is not emailed.
# RESEND_API_KEY=your-resend-api-key

# ── (Optional) Feedback storage via Vercel KV ────────────────────
# Auto-provided when you attach a Vercel KV store to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Verifiable certificates (required ONLY for the /certificate claim flow) ──
# Postgres connection string. In Vercel: Storage -> create a Neon Postgres
# database; it sets DATABASE_URL automatically. Tables auto-create on first use.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# A long random string used to sign issued certificates (keep it secret).
# CERT_SIGNING_SECRET=replace-with-a-long-random-string
# The "From" address for the magic-link email. Verify your domain in Resend first
# (or omit to use Resend's onboarding@resend.dev sandbox sender for testing).
# CERT_EMAIL_FROM=AI for Everyone <certificates@learn2exel.com>
# RESEND_API_KEY is also required here (listed above) to send the confirmation email.
