# ================================================================
# AI for Everyone Course — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ================================================================

# ── Session (iron-session) ───────────────────────────────────────
# Must be at least 32 random characters. Generate one at:
# https://1password.com/password-generator/ (set to 32+ chars)
SESSION_PASSWORD=replace-this-with-a-random-32-char-string-minimum

# ── Supabase ─────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── (Optional) Public Supabase key — not used in this app ────────
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
